# Copy to .env.local for local dev. On Vercel, set these in Project Settings → Environment Variables.

# Public (bundled into the browser — safe: protected by Supabase Row Level Security)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Server-only (used by /api/recommendations — never prefix with VITE_)
GEMINI_API_KEY=your-gemini-api-key
# Optional: a model to try first. Otherwise the free-tier models gemini-3.5-flash, then
# gemini-3.1-flash-lite are used (the next is tried if Google retires one).
# GEMINI_MODEL=gemini-3.5-flash
# Optional: AI suggestions per user per hour (default 10)
# AI_HOURLY_LIMIT=10
