# Copy to .env.local for local dev. On Vercel, set these in Project Settings → Environment Variables.

# Public (bundled into the browser — safe: protected by Supabase Row Level Security)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Server-only (used by /api/recommendations — never prefix with VITE_)
GEMINI_API_KEY=your-gemini-api-key
# Optional override; defaults to gemini-3.5-flash
# GEMINI_MODEL=gemini-3.5-flash
